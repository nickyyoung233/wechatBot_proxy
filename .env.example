# WeChat Configuration
WECHAT_TOKEN=your_wechat_token_here
WECHAT_APPID=your_wechat_appid_here
WECHAT_APPSECRET=your_wechat_appsecret_here

# Coze Configuration
COZE_API_KEY=your_coze_api_key_here
COZE_BOT_ID=your_coze_bot_id_here
# Optional: set to https://api.coze.com or https://api.coze.cn
COZE_API_BASE=https://api.coze.com
# Optional: poll interval when waiting Coze chat completion (milliseconds)
COZE_POLL_INTERVAL_MS=1500
# Optional: max total wait time for Coze chat completion (milliseconds)
COZE_POLL_TIMEOUT_MS=60000

# ── Scheduled Push Configuration ──────────────────────────────────────────────
# 推送给谁：目标用户的微信 OpenID
WECHAT_PUSH_OPENID=your_target_openid_here

# 详情页基础域名（建议填写生产域名，避免使用临时预览域名）
BASE_URL=https://your-app.vercel.app

# 微信模板消息配置（每日推送）
WECHAT_TEMPLATE_ID=your_wechat_template_id_here
# 可选：模板字段映射（请按你的模板字段名修改）
WECHAT_TEMPLATE_KEY_TITLE=first
WECHAT_TEMPLATE_KEY_CONTENT=keyword1
WECHAT_TEMPLATE_KEY_TIME=keyword2
WECHAT_TEMPLATE_KEY_REMARK=remark
# 可选：模板固定文案
WECHAT_TEMPLATE_TITLE=每日情报推送
WECHAT_TEMPLATE_REMARK=点击查看完整详情

# Coze 定时任务的固定指令（可自定义）
CRON_PROMPT=【定时任务触发】：现在请开始执行今日前端技术情报总结。

# Cron 安全密钥（Vercel 自动调用时会校验）
# 在 Vercel Dashboard 中配置同名环境变量后，Cron 请求会携带此 Token
CRON_SECRET=your_random_secret_here

# Optional: Server Port for local testing
PORT=3000
